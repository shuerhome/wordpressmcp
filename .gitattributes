# 统一以 LF 存储文本,避免跨平台换行噪声
* text=auto eol=lf
*.php text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf

# 不打进插件安装包的文件(git archive / bin/build-zip.sh 使用)
/.github export-ignore
/bin export-ignore
/tests export-ignore
/docs export-ignore
/composer.json export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
